/include/ "system-conf.dtsi"

/ {
/*------------------ PS-PL CLK --------------------*/
  fclk0: fclk0 {
    status = "okay";
    compatible = "xlnx,fclk";
    clocks = <&zynqmp_clk PL0_REF>;
    //clocks = <&zynqmp_clk 71>;
    clock-names = "pl_clk0";
  };
  /* PL1_REF (150 MHz) is the AD9913 DDS reference clock. Claim it so the
   * common-clock framework keeps it enabled; otherwise Linux gates it as an
   * unused clock at boot and the DDS sees no SYSCLK (PLL is bypassed), so it
   * outputs DC. u-boot leaves it running, which is why DDS bring-up works
   * from u-boot but not from Linux. */
  fclk1: fclk1 {
    status = "okay";
    compatible = "xlnx,fclk";
    clocks = <&zynqmp_clk PL1_REF>;
    clock-names = "pl_clk1";
  };
};

/*-------------------- SD0 eMMC ----------------*/
&sdhci0 {
    // 1.8V
    bus-width = <8>;
};


/*-------------------- SD1 sd2.0 ----------------*/
&sdhci1 {
    // 3.3V
    disable-wp;
    no-1-8-v;
};


/*-------------------- USB 2.0 disabled (no USB in XSA) ----------------*/
&usb0 {
    status = "disabled";
};

&dwc3_0 {
    status = "disabled";
};


/*------------------ ETH PHY --------------------*/
&gem3 {
    phy-handle = <&phy0>;

    nvmem-cells = <&eth0_addr>;
    nvmem-cell-names = "mac-address";

    //required otherwise petalinux gives a static address here
    /delete-property/ local-mac-address;

    phy0: phy0@1 {
        device_type = "ethernet-phy";
        reg = <1>;
    };
};


/*-------------------- QSPI ---------------------*/
&qspi {
    num-cs = <2>;

    flash@0 {
        compatible = "jedec,spi-nor";
        reg = <0>, <1>;
        parallel-memories = /bits/ 64 <0x10000000 0x10000000>;  
        /* 0x10000000 =  256MB dual as maximum; 
           this is a proprietary property from u-boot/linux-xlnx. it is used in u-boot and does work if it is larger than the connected qspi, even though the displayed size if wrong
           we implemented a linux patch that uses the size which is read back from the qspi itself
        */
        spi-rx-bus-width = <4>;
        spi-tx-bus-width = <4>;
        spi-max-frequency = <108000000>; // max. frequency also depends on the QSPI chip
                                         // here 108MHz for N25Q512A (Fast Read Quad IO STR, 8 Dummy Cycles, quad SPI protocol)

        #address-cells = <1>;
        #size-cells = <1>;
    };
};


/*------------------ I2C --------------------*/
&i2c0 {
    eeprom: eeprom@50 {
        compatible = "microchip,24aa025", "atmel,24c02";
        reg = <0x50>;
            
            #address-cells = <1>;
            #size-cells = <1>;
            eth0_addr: eth-mac-addr@FA {
              reg = <0xFA 0x06>;
            };
        };
};

/*
 * The OLED SPI interface is connected to PS MIO SPI0.
 *     - CS0 is OLED
 */
&spi0 {
    #address-cells=<1>;
    #size-cells=<0>;
    status = "okay";
    num-cs = <1>;
    //bus-num = <0>;        // may not be needed
    is-decoded-cs = <0>;

    spidev@0x00 {
        //compatible = "spidev";            // not in kernel allowlist, will not bind
        compatible = "rohm,dh2228fv";
        //compatible = "oled_mftr,oled_pn"; // NOTE: use this if specific oled driver is available

        /* Max SPI clock frequency via Zynq EMIO is 25MHz */
        spi-max-frequency = <25000000>;

        /* slave number - CS */
        reg = <0>;

        /* Set SPI mode = 0, adjust if necessary */
        spi-cpol = <0>;
        spi-cpha = <0>;
    };
};

/*
 * The clock device AD9913 is connected to PS SPI1 through EMIO through the PL.
 *     - CS0 is AD9913
 *     - CS1 is ???
 */
&spi1 {
    #address-cells=<1>;
    #size-cells=<0>;
    status = "okay";
    num-cs = <2>;
    //bus-num = <1>;        // may not be needed
    is-decoded-cs = <0>;

    spidev@0x00 {
        //compatible = "spidev";        // not in kernel allowlist, will not bind
        compatible = "rohm,dh2228fv";

        /* Max SPI clock frequency via Zynq EMIO is 25MHz */
        spi-max-frequency = <25000000>;

        /* slave number - CS */
        reg = <0>;

        /* Set SPI mode = 0, adjust if necessary */
        spi-cpol = <0>;
        spi-cpha = <0>;
    };

    spidev@0x01 {
        //compatible = "spidev";        // not in kernel allowlist, will not bind
        compatible = "rohm,dh2228fv";

        /* Max SPI clock frequency via Zynq EMIO is 25MHz */
        spi-max-frequency = <25000000>;

        /* slave number - CS */
        reg = <1>;

        /* Set SPI mode = 0, adjust if necessary */
        spi-cpol = <0>;
        spi-cpha = <0>;
    };
};

/ {
  dma_proxy_rx: dma_proxy_rx {
      compatible = "xlnx,dma_proxy";
      dmas = <&axi_dma_0 0>;        /* channel 0 = S2MM */
      dma-names = "dma_proxy_rx";
  };

  /*------------------ IRIG 1pps interrupt (PL -> PS) --------------------*/
  /* The PL IRIG block (in axi_reg32 at 0x80000000) raises an interrupt on each
   * one-second boundary. tangelo waits on it via UIO, reads IRIG_IN, and
   * disciplines the system clock. The node name embeds "irig" so tangelo's
   * resolveIrigUio() can match /sys/class/uio/uioN/name.
   *
   * The reg maps the same 0x80000000/0x10000 PL register window tangelo also
   * reaches through /dev/mem (both MAP_SHARED — no conflict); UIO here is used
   * for the interrupt delivery, not register access.
   *
   * Interrupt routing confirmed from the XSA (zusys_wrapper_20260619.hwh):
   * tm_intf_top_0/irig_irq -> ilconcat_0 In3 -> zynq_ultra_ps_e_0/pl_ps_irq0[3],
   * SENSITIVITY = LEVEL_HIGH. ZynqMP pl_ps_irq0[0..7] map to GIC SPI 89..96, so
   * bit 3 = SPI 92. Flags 4 = IRQ_TYPE_LEVEL_HIGH (matches the PL). */
  irig_uio: irig@80000000 {
      compatible = "generic-uio";
      reg = <0x0 0x80000000 0x0 0x10000>;
      interrupt-parent = <&gic>;
      interrupts = <0 92 4>;
      status = "okay";
  };
};

/*------------------ SYSMON --------------------*/
/* Disabled: the in-kernel xadc driver (xilinx-xadc-core.c) binds this node
 * and continuously samples its ADC/alarm registers at 0x80010000, which made
 * that range look like it was changing out from under tangelo when it
 * wasn't — tangelo's own PL window stops at 0x80000000/0x10000 and never
 * reaches this address. */
&system_management_wiz_0 {
    status = "disabled";
};

/*
 * Disable APU cores 2 and 3 to reduce static power/heat. Linux never issues a
 * PSCI CPU_ON for these, so the PMU firmware leaves them power-gated. Cores 0
 * (boot) and 1 remain online.
 *
 * The perf PMU node (/pmu in zynqmp.dtsi) lists all four cores in its
 * interrupt-affinity, so deleting cpu2/cpu3 would leave dangling phandles and
 * fail the dtc build. Override /pmu to reference only the surviving cores, and
 * trim its per-core SPI interrupt list (143..146 -> 143,144) to match.
 */
&{/pmu} {
    interrupts = <0 143 4>, <0 144 4>;
    interrupt-affinity = <&cpu0>, <&cpu1>;
};

/delete-node/ &cpu2;
/delete-node/ &cpu3;
